// hello.kbl - базовый пример
print("Привет, мир!\n");

int a = 2;
int b = 3;
println("a + b = " + (a + b));
println("a / b = " + (a / b));
println("a / 2.0 = " + (a / 2.0));

for (int i = 0; i < 3; i++) {
    println("i = " + i);
}

int n = 0;
while (n < 3) {
    n++;
    if (n == 2) continue;
    println("n = " + n);
}

func add(int x, int y) {
    return x + y;
}

println("add(10, 20) = " + add(10, 20));

string s = "kbl";
println("upper: " + upper(s) + ", len: " + len(s));
println("тип 1.5: " + typeof(1.5));
