// notepad.kbl - открывает Блокнот и печатает текст
//
// ВНИМАНИЕ: скрипт управляет клавиатурой. Не запускайте его, пока печатаете
// сами, и не оставляйте в фокусе важные документы.
//
// Аварийная остановка: Ctrl+Alt+Esc

key_press("win+r");
sleep(700);
type("notepad");
key_press("enter");
sleep(1200);

type("Привет из kbl!\nЭтот текст напечатан скриптом.\n");
